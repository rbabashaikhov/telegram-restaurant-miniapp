NODE_ENV=development
PORT=3000

DATA_MODE=local
DATABASE_PATH=./data/restaurant.db

# Demo fallback is explicit. Production must not silently accept fake Telegram users.
ALLOW_DEMO_MODE=true
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=

POS_ADAPTER=local
PAYMENT_ADAPTER=mock
EVENT_ADAPTER=local
EVENT_WEBHOOK_URL=

APP_URL=http://localhost:5173
TZ=Europe/Moscow

BUSINESS_NAME=Nord Bistro
APP_TITLE=Nord Bistro
APP_DESCRIPTION=Современная кухня на Цветном бульваре.
BRAND_ACCENT=#B85C38
CURRENCY=RUB
CURRENCY_SYMBOL=₽

RESERVATION_DURATION_MINUTES=120
RESERVATION_BUFFER_MINUTES=15
SLOT_STEP_MINUTES=30
OPENING_TIME=12:00
CLOSING_TIME=23:00
LOYALTY_EARN_PERCENT=5

FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true
